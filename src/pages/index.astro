---
import Badge from '../components/Badge.astro';
import Layout from '../layouts/Layout.astro';

---

<Layout title="Welcome">
	<section class="w-full lg:w-185 mx-auto py-44">
		
		<img 
        class="rounded-full w-12 h-12 mb-4" 
        src="/img-perfil.jpeg" 
        alt="Foto perfil" />
		
		<h1 class="text-white text-5xl text-bold flex flex-row gap-x-4 pb-10">Hola, soy Santi 
			<a href="https://www.linkedin.com/in/santiago-lópez-silva-667056274"
				target="_blank"
				rel="noopener noreferrer"
				class="flex justify-center items-center"
			>
				<Badge>Disponible para trabajar</Badge>
			</a>
		</h1>

		<h2 class="text-2xl opacity-80 text-wrap">
			+0 años de experiencia. Graduado en Ingeniería Informática. De A Coruña, Galicia.
		</h2>

		<ul>

		</ul>
	</section>

</Layout>
