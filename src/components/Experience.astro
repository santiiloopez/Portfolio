---
import ExperienceItem from "./ExperienceItem.astro";

import { work } from '@cv'
---

<ol 
    class="relative mt-16"
    aria-label="Experiencia laboral"
>
    {
        work.map((w, i) => (
            <li class="anim-fade-in" style={`animation-delay: ${i * 150}ms`}>
                <ExperienceItem {...w}/>
            </li>
        ))
    }
</ol>

