        mb-10 flex justify-center"
>
    
    <div 
        class="rounded-lg w-full max-w-7xl mx-auto md:flex md:items-center 
            md:justify-between py-4 flex flex-col md:flex-row items-center gap-4"
    >
        <span 
            class="text-sm text-center text-pretty md:text-left text-zinc-800/90
                dark:text-zinc-200/90"
        >
            &copy; {currentYear} 
            <a 
                href="https://www.linkedin.com/in/santiago-lópez-silva-667056274" 
                target="_blank" rel="noopener noreferrer" 
                class="hover:underline"
            > Santiago López Silva
            </a>
            . Casi todos los derechos reservados.
        </span>
        <ul 
            class="flex flex-wrap items-center text-sm font-medium 
                dark:text-white/90"
        >
            <li>
                <a id="contacto" 
                    href="mailto:santi99lopez@gmail.com" 
                    class="hover:underline"
