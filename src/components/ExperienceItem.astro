---
import LinkInline from './LinkInline.astro'

export interface Props {
    name: string
    position: string
    summary: string
    url?: string
    startDate: string
    endDate: string
}

const { name, position, summary, url, startDate, endDate } = Astro.props
---

<div
    class="relative mx-12 pb-12 grid before:absolute before:-left-8.75 before:block before:h-full before:border-l-2 
    before:border-black/20 dark:before:border-white/15 before:content-[''] md:grid-cols-5 md:gap-10 md:space-x-4"
>   
    <!-- Titulo y timeline -->
    <div class="relative pb-12 md:col-span-2">
        <div class="sticky top-0">
            <!-- Title row with dot: flex ensures perfect vertical centering -->
            <div class="flex items-center">
                <span
                    class="absolute -left-10.5 flex size-3.5 items-center justify-center"
                    aria-hidden="true"
                >
                    {!endDate && (
                        <span
                            class="animate-ping motion-reduce:animate-none absolute inline-flex size-full 
                                rounded-full bg-yellow-400/40"
                        >
                        </span>
                    )}
                    <span
                        class={`relative inline-flex size-2.5 rounded-full bg-yellow-400 
                            ${!endDate ? "shadow-[0_0_8px_2px_rgba(251,191,36,0.45)]" : ""}`}
                    >
                    </span>
                </span>

                <h3 class="text-xl font-bold text-yellow-400">
                    {position}
                </h3>
            </div>
            <h4 class="font-semibold text-xl text-gray-600 dark:text-white">{name}</h4>
            <time class="p-0 m-0 text-sm text-gray-600/80 dark:text-white/80">
                {startDate} - {endDate ? endDate : "Actualidad"}
            </time>
        </div>
    </div>
    <!-- Descripcion -->
    <div class="relative flex flex-col gap-2 pb-4 text-gray-600 dark:text-gray-300 md:col-span-3">
        {summary}
        {
            url && (
                <LinkInline href={url}>
                    Saber más sobre {name} {" "}
                </LinkInline>
            )
        }

    </div>
</div>